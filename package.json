{
  "name": "meezan-react-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:strict": "vite build && node scripts/prune-dist.mjs && node scripts/verify-delivery.mjs --dist",
    "preview": "vite preview --host 0.0.0.0",
    "social:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-social-assets.ps1",
    "content:template": "node scripts/generate-editable-content.mjs",
    "illustrator:assets": "node scripts/build-illustrator-assets.mjs",
    "illustrator:manifest": "node scripts/sync-illustrator-manifest.mjs",
    "illustrator:sync": "npm run illustrator:text:promote && npm run illustrator:text:sync && npm run illustrator:manifest",
    "illustrator:text:sync": "node scripts/sync-illustrator-text-metrics.mjs",
    "illustrator:text:promote": "node scripts/promote-illustrator-text-vectors.mjs",
    "illustrator:crop": "swift scripts/export-illustrator-crop.swift",
    "illustrator:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-illustrator-source.ps1",
    "visual:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-visual-reference.ps1",
    "visual:reference:promote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-visual-reference.ps1 -PromoteExactCrops",
    "visual:audit:candidate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/visual-audit.ps1 -Candidate",
    "visual:candidate": "npm run visual:reference:promote && npm run visual:audit:candidate",
    "visual:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/visual-audit.ps1",
    "visual:approve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/approve-visual-baseline.ps1 -Confirm APPROVE",
    "assets:approve": "node scripts/approve-runtime-assets.mjs --approve",
    "verify:assets": "node scripts/verify-delivery.mjs",
    "verify:provenance": "node scripts/verify-delivery.mjs --provenance",
    "route:smoke": "node scripts/route-smoke.mjs",
    "test:delivery": "npm run route:smoke && npm run visual:audit",
    "delivery:strict": "npm run verify:provenance && npm run build:strict && npm run test:delivery"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.0.16"
  },
  "devDependencies": {}
}
